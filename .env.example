# 复制为 .env 后按需修改；不填也能跑（后端会自动生成密钥）

# 后端
SECRET_KEY=
DATABASE_URL=sqlite:///./data/rss.db
DATA_DIR=./data
CORS_ORIGINS=http://localhost:5173
REFRESH_DEFAULT_MINUTES=60
# 允许抓取内网 / 本机地址（自建 RSSHub、局域网 feed 需要打开；默认关闭以防御 SSRF）
ALLOW_PRIVATE_FETCH=false

# 全文抽取：feed 正文过短时去原网页抽正文
EXTRACT_ENABLED=true
EXTRACT_MIN_CHARS=200
EXTRACT_MAX_PER_REFRESH=10
EXTRACT_CONCURRENCY=3

# AI：流式调上游（stream:true）
# 分块读超时：慢但一直在吐字不会被判超时，只有完全卡住才算
AI_TIMEOUT_SECONDS=60
# 上游 429 / 5xx / 网络失败后的退避重试间隔（秒）；每家最多 2 次尝试，之后切下一家供应商
AI_RETRY_BACKOFF_SECONDS=3

# 前端（可选，仅当不走 Vite 代理时设置）
# VITE_API_BASE=http://localhost:8000

# AI / 集成 / 代理不在环境变量里配置：它们是用户在「设置」弹窗里填的，存在数据库（见 docs/data-model.md）

# 图片缓存：外链图经后端代理并落盘，解决防盗链与外链失效
MEDIA_CACHE_ENABLED=true
# 磁盘预算（MB），超出按 LRU 淘汰
MEDIA_CACHE_MAX_MB=512

# 时区：自动化里「定时」规则的时间按它解释（Docker 默认 UTC，容易差几个小时）
TZ=Asia/Shanghai
