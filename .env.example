# 复制为 .env 后按需修改；不填也能跑（后端会自动生成密钥）

# 后端
SECRET_KEY=
DATABASE_URL=sqlite:///./data/rss.db
DATA_DIR=./data
CORS_ORIGINS=http://localhost:5173
REFRESH_DEFAULT_MINUTES=60
# 允许抓取内网 / 本机地址（自建 RSSHub、局域网 feed 需要打开；默认关闭以防御 SSRF）
ALLOW_PRIVATE_FETCH=false

# 全文抽取：feed 正文过短时去原网页抽正文
EXTRACT_ENABLED=true
EXTRACT_MIN_CHARS=200
EXTRACT_MAX_PER_REFRESH=10
EXTRACT_CONCURRENCY=3

# 前端（可选，仅当不走 Vite 代理时设置）
# VITE_API_BASE=http://localhost:8000

# ---- 后续模块预留（本阶段未实现，见 docs/roadmap.md）----
